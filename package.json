{
  "name": "chisan",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "pnpm lint && pnpm build",
    "check:csv": "node scripts/audit-csv.js --all",
    "check:csv:changed": "node scripts/audit-csv.js --changed",
    "check:evidence": "node scripts/check-evidence.mjs",
    "check:evidence:changed": "node scripts/check-evidence-changed.mjs",
    "list:producers": "node scripts/list-producers.mjs",
    "check:defects": "node scripts/audit-defects.mjs",
    "check:images": "node scripts/check-images.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:links": "node scripts/check-links.mjs",
    "audit:description-locales": "node scripts/audit-description-locales.mjs",
    "check:translations": "node scripts/check-catalog-translations.mjs --all",
    "check:translations:changed": "node scripts/check-catalog-translations.mjs --changed",
    "build:catalog-geography": "node scripts/build-catalog-area-boundaries.mjs",
    "build:municipalities": "node scripts/build-municipality-centroids.js",
    "check:catalog-geography": "node scripts/check-catalog-area-boundaries.mjs",
    "generate:translations": "node scripts/generate-catalog-translations.mjs",
    "benchmark:translations": "node scripts/benchmark-catalog-translations.mjs",
    "report:translation-readiness": "node scripts/report-catalog-translation-readiness.mjs",
    "enrich:images": "python3 scripts/enrich-producer-images.py",
    "test:csv-audit": "bash scripts/test-csv-audit.sh && node --test scripts/test-producer-route-alias-history.mjs",
    "test:images": "node scripts/test-check-images.mjs && python3 scripts/test-enrich-images.py",
    "test:evidence-contract": "node scripts/test-evidence-contract.mjs",
    "test:audit-defects": "node --test scripts/test-catalog-operation-scope.mjs && node scripts/test-audit-defects.mjs",
    "test:check-links": "node scripts/test-check-links.mjs",
    "test:i18n": "tsx --test scripts/test-i18n.ts scripts/test-profile-qr.ts",
    "test:accounts": "tsx --test scripts/test-account-database-status.ts scripts/test-account-domain.ts scripts/test-account-i18n.ts scripts/test-account-migration.ts scripts/test-i18n-presentation.ts scripts/test-materialize-producer-change.ts scripts/test-profile-upgrade-domain.ts scripts/test-public-profiles.ts && node --conditions=react-server --import tsx --test scripts/test-profile-gifts-service.ts scripts/test-producer-selections.ts scripts/test-selection-qr-service.ts",
    "test:catalog-geography": "tsx --test scripts/test-area-explorer-ui.ts scripts/test-catalog-area-boundaries.mjs scripts/test-location-onboarding.ts scripts/test-nearby-producer-focus.ts scripts/test-resolve-catalog-area.ts",
    "test:translations": "tsx --test scripts/test-catalog-translations.ts scripts/test-audit-description-locales.mjs",
    "test:vercel-deploy": "node --test scripts/test-vercel-ignore-build.mjs",
    "test:intelligence": "pnpm test:evidence-contract && pnpm test:audit-defects && pnpm test:check-links",
    "test:behavior": "bash scripts/test-behavior.sh",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "tsx scripts/migrate-account-database.ts",
    "db:assert-current": "tsx scripts/assert-account-database-current.ts",
    "producer:change": "tsx scripts/materialize-producer-change.ts",
    "producer:access": "tsx scripts/provision-producer-change-access.ts",
    "producer:ids:locked": "node scripts/with-producer-id-lock.mjs",
    "test:producer-id-lock": "node --test scripts/test-producer-id-lock.mjs",
    "verify:data": "pnpm check:csv && pnpm check:images && pnpm check:evidence && pnpm check:translations && pnpm check:content",
    "verify:ai": "pnpm check:docs && pnpm verify && pnpm check:design && pnpm db:check && pnpm test:i18n && pnpm test:accounts && pnpm verify:data && pnpm test:translations && pnpm test:vercel-deploy && pnpm check:catalog-geography && pnpm test:catalog-geography && pnpm test:csv-audit && pnpm test:images && pnpm test:intelligence && pnpm test:producer-id-lock && pnpm test:behavior && pnpm test:content",
    "check:docs": "node scripts/check-docs.mjs",
    "check:content": "tsx scripts/check-producer-content.ts",
    "producer:content": "tsx scripts/producer-content.ts",
    "producer:inspect": "tsx scripts/inspect-producer.ts",
    "test:content": "tsx --test scripts/test-producer-content.ts scripts/test-producer-inspection.ts scripts/test-producer-content-render.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "7.7.9",
    "@phosphor-icons/react": "2.1.10",
    "@vercel/analytics": "^2.0.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "6.8.3",
    "drizzle-orm": "0.45.2",
    "leaflet": "^1.9.4",
    "next": "16.1.6",
    "postgres": "3.4.9",
    "qrcode.react": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-leaflet": "^5.0.0",
    "server-only": "0.0.1",
    "stripe": "22.5.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.5",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "franc": "6.2.0",
    "tsx": "4.23.12",
    "typescript": "^5"
  }
}
