# Public key from the SAME Clerk instance as the target Chisan web deployment.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Public API / web origin. Use a reachable LAN address for physical-device QA.
EXPO_PUBLIC_CHISAN_ORIGIN=https://chisan.app
# Enable only after native Sign in with Apple is configured and tested in Clerk.
EXPO_PUBLIC_CHISAN_APPLE_SIGN_IN_ENABLED=false
