# Public application origin. Override only for an isolated local or preview environment.
NEXT_PUBLIC_APP_URL=https://chisan.app

# Public discovery stays off unless Production sets this exact value to true.
CHISAN_PUBLIC_DISCOVERY_ENABLED=false

# Accounts stay off unless this exact value is true.
CHISAN_ACCOUNTS_ENABLED=false

# Operational freeze for new producer profile proposals. Existing requests and
# staff review remain available when accounts are enabled.
CHISAN_PRODUCER_CHANGES_ENABLED=true

# Clerk authentication (use separate development/preview/production instances).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/acceso
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cuenta/bienvenida
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cuenta/bienvenida

# PostgreSQL. The application is provider-agnostic; use an isolated database per environment.
DATABASE_URL=
# Prefer a direct/unpooled connection with DDL privileges for migrations.
DATABASE_MIGRATION_URL=

# Verified emails in this comma-separated list receive the initial admin grant.
# Remove this bootstrap after permanent staff grants have been created.
CHISAN_ADMIN_EMAILS=

# Optional map-provider overrides.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_MAX_ZOOM=
NEXT_PUBLIC_MAP_SUBDOMAINS=
NEXT_PUBLIC_MAP_VIEW_URL_TEMPLATE=
