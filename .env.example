# Public application origin. Override only for an isolated local or preview environment.
NEXT_PUBLIC_APP_URL=https://chisan.app

# Public discovery stays off unless Production sets this exact value to true.
CHISAN_PUBLIC_DISCOVERY_ENABLED=false

# AdSense ownership can be configured without serving ads. The account id is
# public by design and uses the ca-pub- form. Keep the serving flag false until
# the site is approved, the Google-certified CMP is published and the manual
# area ad unit exists. Preview and Development remain ad-free regardless.
CHISAN_ADSENSE_ACCOUNT_ID=
CHISAN_ADSENSE_AREA_SLOT_ID=
CHISAN_ADSENSE_CMP_READY=false
CHISAN_PROGRAMMATIC_ADS_ENABLED=false

# Accounts stay off unless this exact value is true.
CHISAN_ACCOUNTS_ENABLED=false

# Operational freeze for new producer profile proposals. Existing requests and
# staff review remain available when accounts are enabled.
CHISAN_PRODUCER_CHANGES_ENABLED=true

# Deferred payment adapter. Keep false everywhere and leave the Stripe and offer
# variables unset until the reviewed activation gate in docs/OPERATIONS.md is
# explicitly scheduled and completed. This flag never disables audited admin
# gifts. After any Checkout Session exists, never remove the adapter
# configuration; this flag stops only new Sessions (see docs/OPERATIONS.md).
CHISAN_PROFILE_UPGRADE_CHECKOUT_ENABLED=false

# Dormant Stripe adapter configuration. It is not needed for the premium
# capability or admin gifts. Do not provision or populate it while activation
# remains deferred; secrets belong only in the deployment secret manager.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PROFILE_UPGRADE_PRICE_ID=

# Required before enabling new profile-upgrade Checkout. The versioned terms
# must state the fiscal treatment and refund/support policy.
CHISAN_PROFILE_UPGRADE_TERMS_URL=
CHISAN_BILLING_SUPPORT_EMAIL=

# Clerk authentication (use separate development/preview/production instances).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/acceso
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/registro
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/cuenta/bienvenida
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/cuenta/bienvenida

# PostgreSQL. The application is provider-agnostic; use an isolated database per environment.
DATABASE_URL=
# Prefer a direct/unpooled connection with DDL privileges for migrations.
DATABASE_MIGRATION_URL=

# Verified emails in this comma-separated list receive the initial admin grant.
# Remove this bootstrap after permanent staff grants have been created.
CHISAN_ADMIN_EMAILS=

# Optional map-provider overrides.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION=
NEXT_PUBLIC_MAP_MAX_ZOOM=
NEXT_PUBLIC_MAP_SUBDOMAINS=
NEXT_PUBLIC_MAP_VIEW_URL_TEMPLATE=
