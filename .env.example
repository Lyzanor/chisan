DATABASE_URL="postgresql://km0:km0@localhost:5432/km0?schema=public"
POSTGRES_DB=km0
POSTGRES_USER=km0
POSTGRES_PASSWORD=km0
POSTGRES_PORT=5432

# Map provider (tiles + external links)
# NEXT_PUBLIC_MAP_PROVIDER: osm | maptiler
NEXT_PUBLIC_MAP_PROVIDER=osm
NEXT_PUBLIC_MAP_PROVIDER_LABEL=OpenStreetMap
# Leave empty to use provider defaults (OSM by default)
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_ATTRIBUTION='&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
NEXT_PUBLIC_MAP_MAX_ZOOM=19
# Optional comma list for tile subdomains (example: a,b,c)
NEXT_PUBLIC_MAP_SUBDOMAINS=
# Required only when NEXT_PUBLIC_MAP_PROVIDER=maptiler
NEXT_PUBLIC_MAPTILER_KEY=
NEXT_PUBLIC_MAPTILER_STYLE=streets-v2
# Optional: custom external map link template.
# Can use {lat}, {lon}, {query} (url-encoded), {query_raw}
NEXT_PUBLIC_MAP_VIEW_URL_TEMPLATE=

# Geocoding (Nominatim / OpenStreetMap)
GEOCODING_PROVIDER=nominatim
GEOCODING_ENABLED=true
# Optional cap to avoid very long seed runs; unset for unlimited
GEOCODING_MAX_REQUESTS=800
GEOCODING_DELAY_MS=1100
GEOCODING_RETRIES=3
GEOCODING_TIMEOUT_MS=15000
GEOCODING_STRICT_BARCELONA_BOUNDS=true
# Generic override for provider base URL
GEOCODING_BASE_URL=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org/search
NOMINATIM_USER_AGENT="km0-mapa-seed/1.0"
NOMINATIM_EMAIL=""
