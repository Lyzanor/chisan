generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Producer {
  id            Int      @id @default(autoincrement())
  slug          String   @unique @db.VarChar(240)
  name          String   @db.VarChar(255)
  city          String?  @db.VarChar(120)
  category      String?  @db.VarChar(120)
  subcategory   String?  @db.VarChar(180)
  address       String?  @db.Text
  description   String?  @db.Text
  openingHours  String?  @db.Text
  phone         String?  @db.VarChar(80)
  email         String?  @db.VarChar(180)
  website       String?  @db.Text
  facebook      String?  @db.Text
  instagram     String?  @db.Text
  googleMapsUrl String?  @db.Text
  reviewed      Boolean  @default(false)
  latitude      Float?
  longitude     Float?
  dedupeKey     String   @unique @db.VarChar(400)
  searchText    String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([city])
  @@index([category])
  @@index([subcategory])
  @@index([latitude, longitude])
  @@index([category, subcategory])
  @@index([city, category, subcategory])
}

model GeocodeCache {
  id        Int           @id @default(autoincrement())
  queryKey  String        @unique @db.VarChar(400)
  queryText String        @db.Text
  latitude  Float?
  longitude Float?
  status    GeocodeStatus @default(SUCCESS)
  source    String?       @db.VarChar(40)
  lastError String?       @db.Text
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status])
}

enum GeocodeStatus {
  SUCCESS
  NOT_FOUND
  ERROR
}
